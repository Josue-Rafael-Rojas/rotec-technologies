---
import BrandLogo from './BrandLogo.astro';

const currentYear = new Date().getFullYear();

const footerColumns = [
	{
		title: 'Soluciones',
		links: [
			{ href: '#nomina', label: 'Automatización de nómina' },
			{ href: '#ia-whatsapp', label: 'Flujos de IA en WhatsApp' },
		],
	},
	{
		title: 'Empresa',
		links: [{ href: '#nosotros', label: 'Nosotros' }],
	},
];

const contactEmail = 'rotectechnologies@gmail.com';
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<BrandLogo variant="light" />
			<p class="footer-description">
				Automatizamos la nómina y llevamos la inteligencia artificial a WhatsApp para que las pymes
				ahorren tiempo y crezcan sin fricción.
			</p>
		</div>

		{footerColumns.map(({ title, links }) => (
			<nav class="footer-column" aria-label={title}>
				<h2 class="footer-title">{title}</h2>
				<ul class="footer-links">
					{links.map(({ href, label }) => (
						<li><a href={href}>{label}</a></li>
					))}
				</ul>
			</nav>
		))}
	</div>

	<div class="container footer-bottom">
		<p>© {currentYear} ROTEC Technologies. Todos los derechos reservados.</p>
		<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-background-inverse);
		color: var(--color-text-inverse);
		padding-top: 64px;
	}

	.site-footer :focus-visible {
		outline-color: var(--color-white);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr repeat(2, 1fr);
		gap: 48px;
		padding-bottom: 48px;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 20px;
	}

	.footer-description {
		max-width: 340px;
		margin: 0;
		color: var(--color-text-inverse-muted);
		font-size: 0.95rem;
	}

	.footer-title {
		margin: 0 0 16px;
		font-family: var(--font-brand);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.footer-links {
		display: grid;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer-links a,
	.footer-bottom a {
		color: var(--color-text-inverse-muted);
		font-size: 0.92rem;
		text-decoration: none;
		transition: color 0.2s;
	}

	.footer-links a:hover,
	.footer-bottom a:hover {
		color: var(--color-text-inverse);
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 12px;
		padding-block: 24px;
		border-top: 1px solid var(--color-border-inverse);
		color: var(--color-text-inverse-muted);
		font-size: 0.85rem;
	}

	.footer-bottom p {
		margin: 0;
	}

	@media (max-width: 860px) {
		.footer-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 480px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 36px;
		}
	}
</style>
